config ZELOS_CANOPEN
	bool "CANopen node runtime"
	depends on CAN
	select ZELOS_CAN
	select CANOPENNODE
	help
	  Runs the CANopenNode stack (the canopennodezephyr module) for a
	  node that builds its own object dictionary, od/CO_OD.c and
	  od/CO_OD.h. The stack shares the controller lib/can owns: its
	  driver here (CO_driver.c) sends through lib/can's queue and never
	  stops or reconfigures the controller. See include/zelos/canopen.h.

config ZELOS_CANOPEN_NODE_ID
	int "CANopen node-id"
	depends on ZELOS_CANOPEN
	range 1 127
	default 32
	help
	  0x20 puts the node's COB-IDs clear of the bench and XCP
	  identifiers: NMT 0x000, SYNC 0x080, EMCY 0x0A0, TPDO1 0x1A0,
	  RPDO1 0x220, TPDO2 0x2A0, RPDO2 0x320, TPDO3 0x3A0,
	  SDO 0x5A0/0x620, heartbeat 0x720. TIME is fixed at 0x100.
