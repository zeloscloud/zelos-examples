diff --git a/subsys/canbus/isotp/isotp.c b/subsys/canbus/isotp/isotp.c
index b2a8401..73d0d8c 100644
--- a/subsys/canbus/isotp/isotp.c
+++ b/subsys/canbus/isotp/isotp.c
@@ -551,6 +551,14 @@ static void process_cf(struct isotp_recv_ctx *rctx, struct can_frame *frame)
 	}
 }
 
+static bool is_fc(const struct isotp_msg_id *addr, const struct can_frame *frame)
+{
+	int index = (addr->flags & ISOTP_MSG_EXT_ADDR) != 0 ? 1 : 0;
+
+	return can_dlc_to_bytes(frame->dlc) > index &&
+	       (frame->data[index] & ISOTP_PCI_TYPE_MASK) == ISOTP_PCI_TYPE_FC;
+}
+
 static void receive_can_rx(const struct device *dev, struct can_frame *frame, void *arg)
 {
 	struct isotp_recv_ctx *rctx = (struct isotp_recv_ctx *)arg;
@@ -561,6 +569,11 @@ static void receive_can_rx(const struct device *dev, struct can_frame *frame, vo
 		return;
 	}
 
+	/* A receiver ignores FCs (ISO 15765-2), e.g. one another tester sent late. */
+	if (is_fc(&rctx->rx_addr, frame)) {
+		return;
+	}
+
 	switch (rctx->state) {
 	case ISOTP_RX_STATE_WAIT_FF_SF:
 		__ASSERT_NO_MSG(rctx->buf);
@@ -860,9 +873,17 @@ static void send_can_rx_cb(const struct device *dev, struct can_frame *frame, vo
 		return;
 	}
 
-	if (sctx->state == ISOTP_TX_WAIT_FC) {
+	/*
+	 * An FC is expected only once the FF or the block's last CF went out (N_Bs
+	 * runs from its confirmation). Any other FC, e.g. a second tester's, is
+	 * ignored (ISO 15765-2 9.8.3): adopted, it would release a CF while a
+	 * frame is pending.
+	 */
+	if (sctx->state == ISOTP_TX_WAIT_FC && sctx->tx_backlog == 0) {
 		k_timer_stop(&sctx->timer);
 		send_process_fc(sctx, frame);
+	} else if (is_fc(&sctx->rx_addr, frame)) {
+		return;
 	} else {
 		LOG_ERR("Got unexpected PDU");
 		send_report_error(sctx, ISOTP_N_UNEXP_PDU);
@@ -982,7 +1003,16 @@ static inline int send_ff(struct isotp_send_ctx *sctx)
 	pull_send_ctx_data(sctx, sctx->tx_addr.dl - index);
 	memcpy(&frame.data[index], data, sctx->tx_addr.dl - index);
 
+	/*
+	 * Pending like a CF: no FC is due before it went out. Counted before
+	 * can_send(), whose callback may run before it returns.
+	 */
+	sctx->tx_backlog++;
 	ret = can_send(sctx->can_dev, &frame, K_MSEC(ISOTP_A_TIMEOUT_MS), send_can_tx_cb, sctx);
+	if (ret != 0) {
+		sctx->tx_backlog--;
+	}
+
 	return ret;
 }
 
@@ -1024,12 +1054,15 @@ static inline int send_cf(struct isotp_send_ctx *sctx)
 		frame.dlc = can_bytes_to_dlc(len + index);
 	}
 
+	/* Before can_send(), as in send_ff(). */
+	sctx->tx_backlog++;
 	ret = can_send(sctx->can_dev, &frame, K_MSEC(ISOTP_A_TIMEOUT_MS), send_can_tx_cb, sctx);
 	if (ret == 0) {
 		sctx->sn++;
 		pull_send_ctx_data(sctx, len);
 		sctx->bs--;
-		sctx->tx_backlog++;
+	} else {
+		sctx->tx_backlog--;
 	}
 
 	ret = ret ? ret : rem_len;
@@ -1098,6 +1131,15 @@ static void send_state_machine(struct isotp_send_ctx *sctx)
 		LOG_DBG("SM send CF");
 		k_timer_stop(&sctx->timer);
 		do {
+			/*
+			 * One CF in flight: a controller that queues by priority
+			 * (M_CAN TFQM) sends equal identifiers by buffer index,
+			 * not in the order they were queued.
+			 */
+			while (sctx->tx_backlog > 0) {
+				k_sem_take(&sctx->tx_sem, K_FOREVER);
+			}
+
 			ret = send_cf(sctx);
 			if (!ret) {
 				sctx->state = ISOTP_TX_WAIT_BACKLOG;
@@ -1121,9 +1163,6 @@ static void send_state_machine(struct isotp_send_ctx *sctx)
 				sctx->state = ISOTP_TX_WAIT_ST;
 				break;
 			}
-
-			/* Ensure FIFO style transmission of CF */
-			k_sem_take(&sctx->tx_sem, K_FOREVER);
 		} while (ret > 0);
 
 		break;
@@ -1223,6 +1262,7 @@ static int send(struct isotp_send_ctx *sctx, const struct device *can_dev,
 	}
 
 	k_sem_init(&sctx->tx_sem, 0, 1);
+	sctx->tx_backlog = 0;
 	sctx->can_dev = can_dev;
 	sctx->tx_addr = *tx_addr;
 	sctx->rx_addr = *rx_addr;
