# The CAN bench. Run `just` for the list of recipes.
#
# CI runs these same recipes, so it cannot diverge from the guide.

set shell := ["bash", "--noprofile", "--norc", "-euo", "pipefail", "-c"]

REPO := "zeloscloud/zelos-examples"
APPS := "vcu bms dcdc"

# The firmware is built by the repository's shared recipes, one level up.
FIRMWARE := quote(just_executable()) + " --justfile " + quote(justfile_directory() / ".." / "justfile")

# Show the available recipes.
default:
    @just --list --unsorted

# Bring the bench up. Idempotent.
up: _elf
    docker compose up -d --wait
    @echo
    @echo "Bench is up. Connect the Zelos app to localhost:${BENCH_PORT:-2300}"
    @echo "  (or <this host>:${BENCH_PORT:-2300} from another machine)"
    @echo "Watch the raw bus with:  just bus"

# Stop the bench and remove its containers, network and virtual interface.
down:
    docker compose down --remove-orphans --volumes

# Tail the decoded bus as plain text. Proves traffic without opening the app.
bus:
    docker compose exec renode candump -td vcan0

# Run every test notebook against the running bench.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    failed=()
    for nb in notebooks/*.md; do
        name=$(basename "$nb")
        echo "==> ${name}"
        docker compose exec -T agent \
            zelos notebook run "/notebooks/${name}" -o "/notebooks/${name%.md}.html" \
            || failed+=("${name}")
    done
    # The agent writes its rendered pages 0600 and owned by root, so the user
    # who asked for them cannot open them. Fixed from inside the container,
    # because only root there can.
    docker compose exec -T agent sh -c 'chmod a+r /notebooks/*.html' || true
    if [ ${#failed[@]} -gt 0 ]; then
        echo
        echo "failed: ${failed[*]}" >&2
        exit 1
    fi

# Run a chosen build of the DC-DC node: good or defect.
flash VARIANT: _elf
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{ VARIANT }}" in
        good)   elf=dcdc.elf ;;
        defect) elf=dcdc-defect.elf ;;
        *)      echo "usage: just flash good|defect" >&2; exit 2 ;;
    esac
    if [ ! -f "build/$elf" ]; then
        echo "build/$elf is missing. Run 'just firmware', or fetch a release that has it." >&2
        exit 1
    fi
    # A full cycle rather than recreating one service: the agent shares the bus
    # container's network namespace, and recreating the bus underneath it leaves
    # the agent with no network. This also gives the agent a fresh store.
    docker compose down --remove-orphans >/dev/null
    DCDC_ELF="$elf" docker compose up -d --wait
    echo
    echo "DC-DC is now the {{ VARIANT }} build. Give it ~2 min for a drive cycle, then: just test"

# Record the running bench to traces/, for a test to check against later.
#
# trz2 rather than the default: the legacy format is a DuckDB database with a
# 2.8 MB floor regardless of window, where this is about 100 KB.
record NAME:
    docker compose exec -T agent zelos live export \
        --output "/traces/{{ NAME }}.trz" --last 5m --format trz2 --force
    # As with the rendered pages: written 0600 and root-owned. See `test`.
    docker compose exec -T agent sh -c 'chmod a+r /traces/{{ NAME }}.trz'
    @echo "wrote traces/{{ NAME }}.trz"

# Regenerate the CAN codec from the DBC. Deterministic: no timestamps.
dbc:
    {{ FIRMWARE }} dbc

# Rebuild every node, including both builds of the DC-DC.
firmware:
    #!/usr/bin/env bash
    set -euo pipefail
    {{ FIRMWARE }} build vcu build/vcu.elf
    {{ FIRMWARE }} build bms build/bms.elf
    {{ FIRMWARE }} build dcdc build/dcdc.elf
    # The same source with its one Kconfig option turned off.
    {{ FIRMWARE }} build dcdc build/dcdc-defect.elf -- -DEXTRA_CONF_FILE=defect.conf
    ls -la build/*.elf
    # `just up` will not reload a running simulator, so a rebuild alone leaves
    # the previous firmware on the bus.
    if docker compose ps --status running --services 2>/dev/null | grep -qx renode; then
        echo
        echo "The bench is running the previous firmware. Load what you just built:"
        echo "    just flash good"
    fi

# Remove the cached Zephyr workspace. Frees about 2 GB.
clean-workspace:
    {{ FIRMWARE }} clean-workspace

# Firmware must exist and must not be older than its sources.
_elf:
    #!/usr/bin/env bash
    set -euo pipefail

    missing=()
    for app in {{ APPS }}; do
        [ -f "build/$app.elf" ] || missing+=("$app")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        echo "No firmware in build/ (missing: ${missing[*]})."
        echo
        echo "Fetch the prebuilt nodes, which is what most people want:"
        echo "    mkdir -p build && curl -fL --output-dir build -O 'https://github.com/{{ REPO }}/releases/latest/download/{vcu,bms,dcdc,dcdc-defect}.elf'"
        echo
        echo "Or build them from source:"
        echo "    just firmware"
        exit 1
    fi

    # A stale binary is worse than a missing one: the bus looks healthy while
    # the firmware under test is not the firmware on disk. Only what these
    # nodes build from counts, so work on another bench's nodes does not.
    sources=(../nodes/vcu ../nodes/bms ../nodes/dcdc ../lib/can ../lib/codec_bench
             ../lib/Kconfig ../lib/CMakeLists.txt ../include/zelos/can.h ../dbc/bench.dbc
             ../west.yml ../CMakeLists.txt ../Kconfig ../zephyr)
    stale=$(find "${sources[@]}" -type f -newer build/dcdc.elf | head -3)
    if [ -n "${stale}" ]; then
        echo "build/ is older than the sources it came from:" >&2
        echo "${stale}" | sed 's/^/    /' >&2
        echo >&2
        echo "Rebuild before running, or the bench will serve the previous firmware:" >&2
        echo "    just firmware" >&2
        exit 1
    fi
