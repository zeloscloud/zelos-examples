# The full CAN bench. Run `just` for the list of recipes.
#
# CI runs these same recipes, so it cannot diverge from the guide.

set shell := ["bash", "--noprofile", "--norc", "-euo", "pipefail", "-c"]

# The bench's VCU and BMS, and one image carrying every protocol: the DC-DC with
# XCP, UDS and AUTOSAR PDUs, the genset (J1939) and the PDU (CANopen). See nodes/full.
NODES := "vcu bms full"
# Each node with a suite, as node:suite, in the order they run. `just test`
# runs every suite on the bench; `just hil` runs one node's. full's
# coexistence suite runs every protocol at once.
SUITES := "full:xcp full:uds full:obd full:j1939 full:canopen full:autosar full:eth full:full"

# The firmware is built by the repository's shared recipes, one level up.
FIRMWARE := quote(just_executable()) + " --justfile " + quote(justfile_directory() / ".." / "justfile")

# Show the available recipes.
default:
    @just --list --unsorted

# Bring the bench up. Idempotent.
up: (_elf NODES)
    docker compose up -d --wait
    @echo
    @echo "Bench is up. Connect the Zelos app to localhost:${BENCH_PORT:-2300}"
    @echo "Watch the raw bus with:  just bus"

# Stop the bench and remove its containers, network and virtual interface.
down:
    docker compose down --remove-orphans --volumes

# Tail the raw bus.
bus:
    docker compose exec renode candump -td vcan0

# Run the protocol suites against the running bench. --no-deps, because
# recreating the bus would strand the nodes in the old network namespace.
# full's A2L by name: a single-node build may have left another beside it.
test:
    docker compose run --rm --no-deps tester --a2l /elf/full.a2l {{ replace_regex(SUITES, '\S+:', 'suites/') }}

# Build the nodes into build/: the bench's, or the ones you name, e.g. `just build full`.
# full's A2L, the DC-DC's with its addresses, lands beside it. The single-node
# images (dcdc-xcp-uds, pdu) build too, for focused work.
build *names:
    #!/usr/bin/env bash
    set -euo pipefail
    nodes=({{ names }})
    [ ${#nodes[@]} -gt 0 ] || nodes=({{ NODES }})
    for node in "${nodes[@]}"; do
        case "$node" in
            vcu | bms | pdu | full) {{ FIRMWARE }} build "$node" "build/$node.elf" ;;
            dcdc-xcp-uds) {{ FIRMWARE }} build dcdc build/dcdc-xcp-uds.elf -S xcp -S uds ;;
            *) echo "no node '$node'; one of: vcu bms full dcdc-xcp-uds pdu" >&2; exit 2 ;;
        esac
    done
    ls -la build/
    # `just up` will not reload a running simulator.
    if docker compose ps --status running --services 2>/dev/null | grep -qx renode; then
        echo
        echo "The bench is running the previous firmware: just down && just up"
    fi

# Flash the full image and run its suites on a channel, e.g. `just hil full can0`.
hil NODE CHANNEL: (_elf NODE)
    #!/usr/bin/env bash
    set -euo pipefail
    suites=$(for pair in {{ SUITES }}; do [ "${pair%%:*}" != "{{ NODE }}" ] || echo "${pair#*:}"; done)
    [ -n "$suites" ] || { echo "usage: just hil NODE CHANNEL, NODE one of: {{ replace_regex(SUITES, ':\S+', '') }}" >&2; exit 2; }
    # The DC-DC's own behaviour must survive sharing the MCU. can_raw plays
    # the BMS, so `just test`, whose bench has one, cannot run it.
    [ "{{ NODE }}" != full ] || suites+=" can_raw"
    {{ FIRMWARE }} hil "build/{{ NODE }}.elf" {{ CHANNEL }} $suites

# Remove the cached Zephyr workspace. Frees about 2 GB.
clean-workspace:
    {{ FIRMWARE }} clean-workspace

# These nodes' firmware must exist and must not be older than its sources.
_elf ELFS:
    #!/usr/bin/env bash
    set -euo pipefail
    missing=()
    for node in {{ ELFS }}; do
        [ -f "build/$node.elf" ] || missing+=("$node.elf")
    done
    for node in {{ ELFS }}; do
        [[ "$node" != full && "$node" != dcdc-xcp-uds ]] || [ -f "build/$node.a2l" ] || missing+=("$node.a2l")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        echo "No firmware in build/ (missing: ${missing[*]}). Build it:" >&2
        echo "    just build" >&2
        exit 1
    fi
    {{ FIRMWARE }} _fresh "$(printf 'build/%s.elf ' {{ ELFS }})" \
        ../nodes ../lib ../include ../snippets ../tools ../dbc/bench.dbc \
        ../west.yml ../CMakeLists.txt ../Kconfig ../zephyr
