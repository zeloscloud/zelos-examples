# The serial bench. Run `just` for the list of recipes.
#
# CI runs these same recipes, so it cannot diverge from the guide.

set shell := ["bash", "--noprofile", "--norc", "-euo", "pipefail", "-c"]

# The firmware is built by the repository's shared recipes, one level up.
FIRMWARE := quote(just_executable()) + " --justfile " + quote(justfile_directory() / ".." / "justfile")

# Show the available recipes.
default:
    @just --list --unsorted

# Bring the bench up. Idempotent.
up: _elf
    docker compose up -d --wait
    @echo
    @echo "Bench is up. Connect the Zelos app to localhost:${BENCH_PORT:-2300}"
    @echo "Watch the node's console with:  just console"

# Stop the bench and remove its containers and network.
down:
    docker compose down --remove-orphans --volumes

# Tail the console node's output as it prints.
console:
    #!/usr/bin/env bash
    set -euo pipefail
    # From Renode's log, because the console's socket serves one client and
    # the agent holds it.
    docker compose logs -f --tail 100 --no-log-prefix renode-zephyr \
        | sed -n 's/^[^ ]* \[INFO\] usart3: \[[^]]*\] //p'

# Run every notebook against the running bench.
test: _ready
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    notebooks=(notebooks/*.md)
    if [ ${#notebooks[@]} -eq 0 ]; then
        echo "no notebooks in notebooks/" >&2
        exit 1
    fi
    failed=()
    for nb in "${notebooks[@]}"; do
        name=$(basename "$nb")
        echo "==> ${name}"
        docker compose exec -T agent \
            zelos notebook run "/notebooks/${name}" -o "/notebooks/${name%.md}.html" \
            || failed+=("${name}")
    done
    if [ ${#failed[@]} -gt 0 ]; then
        echo
        echo "failed: ${failed[*]}" >&2
        exit 1
    fi

# Build the console node into build/console.elf.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    {{ FIRMWARE }} build console build/console.elf
    # `just up` will not reload a running simulator.
    if docker compose ps --status running --services 2>/dev/null | grep -qx renode-zephyr; then
        echo
        echo "The bench is running the previous firmware: just down && just up"
    fi

# Wait until Serial has both ports open, the node has logged, and Linux has
# booted to its login prompt. `just up` returns before the agent starts Serial.
_ready:
    #!/usr/bin/env bash
    set -euo pipefail
    state() {
        docker compose exec -T agent zelos actions execute Serial/get_state \
            --mode live --params "{\"port\": \"$1\"}" 2>/dev/null || true
    }
    ready() {
        local s
        s=$(state "$1")
        grep -q '"state": "open"' <<<"$s" && grep -Eq "\"$2\": [1-9]" <<<"$s"
    }
    deadline=$((SECONDS + 180))
    until ready dut lines && ready linux prompts; do
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "Serial was not ready after 180 s. Its state:" >&2
            state dut >&2
            state linux >&2
            exit 1
        fi
        sleep 2
    done
    # Renode holds the node's output until Serial connects, then sends it at once,
    # and those lines land at their arrival time. Let 15 s of live output follow.
    sleep 15

# Firmware must exist and must not be older than its sources.
_elf:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f build/console.elf ]; then
        echo "No firmware in build/. Build it:"
        echo "    just build"
        exit 1
    fi
    {{ FIRMWARE }} _fresh build/console.elf \
        ../nodes/console ../lib/Kconfig ../lib/CMakeLists.txt \
        ../west.yml ../CMakeLists.txt ../Kconfig ../zephyr
